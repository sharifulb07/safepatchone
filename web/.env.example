# Set these in the shell or CI before npm run dev/build. The Go generator does
# not read dotenv files. Use public URLs only; these are embedded in the page.
SAFEPATCH_DOWNLOAD_URL=
SAFEPATCH_TRIAL_URL=
SAFEPATCH_SALES_URL=
# Business stays unavailable until its policy is explicitly configured.
SAFEPATCH_BUSINESS_TRIAL_DAYS=0
# Optional JSON keyed by developer/team/business. Each value has amount (decimal
# string), currency (uppercase ISO code), interval (month or year). Use only
# approved prices matching your configured billing offers. Empty stays unpublished.
SAFEPATCH_PUBLIC_PRICES=
# Server only. Fixed Go API origin; never expose credentials through NEXT_PUBLIC_.
# Local public onboarding still requires an HTTPS proxy for Secure cookies.
SAFEPATCH_API_ORIGIN=http://127.0.0.1:8080
# Paddle.js uses a publishable client token only. Never put the API key or webhook
# secret here. Match the Go service's environment and Paddle account.
SAFEPATCH_PADDLE_ENVIRONMENT=sandbox
SAFEPATCH_PADDLE_CLIENT_TOKEN=
