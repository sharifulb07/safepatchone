# Set these in the shell or CI before npm run dev/build. The Go generator does
# not read dotenv files. Use public URLs only; these are embedded in the page.
SAFEPATCH_DOWNLOAD_URL=
SAFEPATCH_TRIAL_URL=
SAFEPATCH_SALES_URL=
# Business stays unavailable until its policy is explicitly configured.
SAFEPATCH_BUSINESS_TRIAL_DAYS=0
# Server only. Fixed Go API origin; never expose credentials through NEXT_PUBLIC_.
# Local public onboarding still requires an HTTPS proxy for Secure cookies.
SAFEPATCH_API_ORIGIN=http://127.0.0.1:8080
