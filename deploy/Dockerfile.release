# The release workflow supplies verified archive binaries; no source is rebuilt.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
ARG TARGETOS
ARG TARGETARCH
ARG COMMAND
COPY --chmod=0555 bin/${TARGETOS}/${TARGETARCH}/${COMMAND} /safepatch
USER 65532:65532
WORKDIR /tmp
ENTRYPOINT ["/safepatch"]
CMD ["--help"]
