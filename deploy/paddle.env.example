# Reference only: the Go service does not automatically load dotenv files.
# Set these in the API process environment or hosting secret manager.
SAFEPATCH_BILLING_PROVIDER=paddle
SAFEPATCH_PADDLE_ENVIRONMENT=sandbox
SAFEPATCH_PADDLE_API_KEY=
SAFEPATCH_PADDLE_WEBHOOK_SECRET=
SAFEPATCH_PADDLE_CONNECTION_ID=paddle_sandbox
SAFEPATCH_PADDLE_ACCOUNT_ID=
SAFEPATCH_PADDLE_PRICES={"developer":"pri_REPLACE","team":"pri_REPLACE","business":"pri_REPLACE"}
# Must match the actual HTTPS origin used by the browser and GitHub OAuth.
SAFEPATCH_PUBLIC_ORIGIN=https://app.example.com
# The API also needs the existing database, NATS, session and GitHub settings.
# See docs/architecture/onboarding.md. Do not configure a Stripe API key here.

# Set these separately in the Next.js process; only the client token is public.
# SAFEPATCH_PADDLE_ENVIRONMENT=sandbox
# SAFEPATCH_PADDLE_CLIENT_TOKEN=test_REPLACE
# SAFEPATCH_API_ORIGIN=http://127.0.0.1:8080

# Optional website build input. Replace with approved amounts matching Paddle.
# SAFEPATCH_PUBLIC_PRICES={"developer":{"amount":"REPLACE","currency":"USD","interval":"month"},"team":{"amount":"REPLACE","currency":"USD","interval":"month"},"business":{"amount":"REPLACE","currency":"USD","interval":"month"}}
